<!-- Всё, что вшивается в бинарник: иконка приложения, иконки тулбара и шрифты.
     Путь до resources/ на машине пользователя неизвестен, а программа должна
     выглядеть одинаково всюду — значит внутрь.

     ИМЯ ФАЙЛА НЕСЁТ РАЗМЕР, ПСЕВДОНИМ ОСТАЁТСЯ НЕЙТРАЛЬНЫМ. Иконка своя на
     каждую систему (замысел владельца): 1024×1024 с бордюрами по краям — маку,
     512×512 — линуксу, под Windows какая лучше, ещё вопрос эксперимента.
     Поэтому на диске лежат zametti1024x1024.png и zametti512x512.png, а код
     всегда спрашивает ":/zametti.png" (app/main.cpp, resources_test.cpp) —
     подмена под платформу становится правкой ОДНОЙ строки ниже, а не обходом
     всех, кто иконку зовёт.

     Правится lossless-вариант, палитра — из него скриптом compress.sh, в
     котором этот шаг однажды уже терялся: файл тогда молча стал весить
     255 207 байт.

     Меры считаются по ДОМНОЖЕННОМУ НА АЛЬФУ цвету. По сырому RGBA их считать
     нельзя: 16% точек иконки полностью прозрачны, палитра пишет под ними
     произвольный цвет, и PSNR падает с 46.6 дБ до 18.5, ничего не говоря о
     видимой картинке.

     ЧИСЛА КАЧЕСТВА ОТНОСЯТСЯ К ПРЕЖНЕЙ, 512-Й РЕДАКЦИИ (PSNR 46.54 дБ,
     SSIM(8x8) 0.9965 при 98 158 байтах против 274 132 у её lossless-исходника).
     Это ровно то, что сегодня зовётся zametti512x512.png. Для нынешней пары
     1024×1024 — 268 475 байт против 672 801 — их НИКТО НЕ ПЕРЕМЕРЯЛ, и
     переписывать сюда чужие числа как свои нельзя. Перемерять — при следующем
     заходе на иконки, тогда же, когда линуксовая сборка возьмёт 512-ю.

     Списки ниже дублируются в app/resources.cpp — и это не случайность: там
     они нужны как таблица, по которой ходят и загрузка, и набор resources.
     Расхождение ловит именно набор, а не молчаливое ":/icons/нет-такой". -->
<RCC>
    <qresource prefix="/">
        <!-- С 05.09.2026 — «alt»-редакция иконки (решение владельца); прежняя
             пара zametti1024x1024.png / zametti512x512.png оставлена на диске
             как была. Исходники alt — zametti_alt_lossless_1024.png и
             _512.png (RGBA), палитра из них тем же compress.sh. Меры alt-пары
             по домноженному на альфу цвету (05.09.2026, свой замер):
             1024 — PSNR 49.08 дБ, SSIM(8x8) 0.9981, 305 469 байт против
             770 844 у lossless; 512 — 47.44 дБ, 0.9976, 112 102 против
             276 031. Тем же замером прежняя 1024-я пара: 48.05 дБ, 0.9981. -->
        <file alias="zametti.png">zametti_alt_1024x1024.png</file>
    </qresource>

    <!-- Иконки Lucide, ISC. Происхождение и список — resources/icons/README.md. -->
    <qresource prefix="/icons">
        <file alias="archive.svg">icons/archive.svg</file>
        <file alias="arrow-down-a-z.svg">icons/arrow-down-a-z.svg</file>
        <file alias="arrow-down.svg">icons/arrow-down.svg</file>
        <file alias="arrow-up.svg">icons/arrow-up.svg</file>
        <file alias="badge-info.svg">icons/badge-info.svg</file>
        <file alias="book-open-text.svg">icons/book-open-text.svg</file>
        <file alias="arrow-up-a-z.svg">icons/arrow-up-a-z.svg</file>
        <file alias="bookmark.svg">icons/bookmark.svg</file>
        <file alias="calendar-arrow-down.svg">icons/calendar-arrow-down.svg</file>
        <file alias="calendar-arrow-up.svg">icons/calendar-arrow-up.svg</file>
        <file alias="check.svg">icons/check.svg</file>
        <file alias="circle-question-mark.svg">icons/circle-question-mark.svg</file>
        <file alias="clock-arrow-down.svg">icons/clock-arrow-down.svg</file>
        <file alias="clock-arrow-up.svg">icons/clock-arrow-up.svg</file>
        <file alias="cloud-sync.svg">icons/cloud-sync.svg</file>
        <file alias="columns-3.svg">icons/columns-3.svg</file>
        <file alias="copy.svg">icons/copy.svg</file>
        <file alias="database-search.svg">icons/database-search.svg</file>
        <file alias="database.svg">icons/database.svg</file>
        <file alias="ellipsis.svg">icons/ellipsis.svg</file>
        <file alias="eye.svg">icons/eye.svg</file>
        <file alias="eye-closed.svg">icons/eye-closed.svg</file>
        <file alias="fast-forward.svg">icons/fast-forward.svg</file>
        <file alias="file-plus-corner.svg">icons/file-plus-corner.svg</file>
        <file alias="folder-input.svg">icons/folder-input.svg</file>
        <file alias="folder-open.svg">icons/folder-open.svg</file>
        <file alias="folder-search.svg">icons/folder-search.svg</file>
        <file alias="folder-plus.svg">icons/folder-plus.svg</file>
        <file alias="folder.svg">icons/folder.svg</file>
        <file alias="image-down.svg">icons/image-down.svg</file>
        <file alias="list-clock.svg">icons/list-clock.svg</file>
        <file alias="lock.svg">icons/lock.svg</file>
        <file alias="lock-open.svg">icons/lock-open.svg</file>
        <file alias="scroll-text.svg">icons/scroll-text.svg</file>
        <file alias="message-square-more.svg">icons/message-square-more.svg</file>
        <file alias="regex.svg">icons/regex.svg</file>
        <file alias="rewind.svg">icons/rewind.svg</file>
        <file alias="rotate-ccw-clock.svg">icons/rotate-ccw-clock.svg</file>
        <file alias="search.svg">icons/search.svg</file>
        <file alias="settings.svg">icons/settings.svg</file>
        <file alias="square-arrow-out-up-right.svg">icons/square-arrow-out-up-right.svg</file>
        <file alias="square-m.svg">icons/square-m.svg</file>
    </qresource>

    <!-- Документации ЗДЕСЬ НЕТ, и это нарочно. Всё, что лежит в docs/info/,
         вшивается порождённым списком (app/info_docs.qrc.in → каталог сборки):
         положил файл туда — он в программе, руками ничего не правится. Список
         под присмотром CMake, а не наш, потому что расширять документацию
         будут файлами, а не правками кода.

         Здесь остаются только лицензии: их список — не каталог, а перечень
         обязательств, и каждая строка в нём стоит осознанно. Пути ведут наружу
         из resources/: файлы живут там, где им место (корень и 3rdparty/), а
         копия рядом с qrc протухала бы молча. Список дублируется в
         app/resources.cpp — как и у иконок, чтобы пропавший файл ловил набор,
         а не пустая вкладка. -->
    <qresource prefix="/licenses">
        <file alias="zametti.txt">../LICENSE</file>
        <file alias="ibm-plex.txt">fonts/LICENSE</file>
        <file alias="source-serif-4.txt">fonts/LICENSE-SourceSerif4</file>
        <file alias="source-code-pro.txt">fonts/LICENSE-SourceCodePro</file>
        <file alias="lucide.txt">icons/LICENSE</file>
        <file alias="md4c.txt">../3rdparty/md4c/LICENSE.md</file>
        <file alias="blake3.txt">../3rdparty/blake3/LICENSE</file>
        <file alias="dtl.txt">../3rdparty/dtl/COPYING</file>
        <file alias="zstd.txt">../3rdparty/zstd/LICENSE</file>
        <file alias="zlib.txt">../3rdparty/zlib/LICENSE</file>
        <file alias="libtiff.txt">../3rdparty/libtiff/upstream/LICENSE.md</file>
        <file alias="highway.txt">../3rdparty/highway/upstream/LICENSE</file>
        <file alias="libjxl.txt">../3rdparty/libjxl/upstream/LICENSE</file>
        <file alias="jpegli.txt">../3rdparty/jpegli/upstream/LICENSE</file>
        <file alias="libwebp.txt">../3rdparty/libwebp/upstream/COPYING</file>
        <file alias="libde265.txt">../3rdparty/libde265/upstream/COPYING</file>
        <file alias="libgav1.txt">../3rdparty/libgav1/upstream/LICENSE</file>
        <file alias="libheif.txt">../3rdparty/libheif/upstream/COPYING</file>
        <file alias="libsodium.txt">../3rdparty/libsodium/upstream/LICENSE</file>
        <file alias="microtex.txt">../3rdparty/microtex/upstream/LICENSE</file>
    </qresource>

    <!-- The embedded faces, all OFL 1.1: IBM Plex Mono and Sans (static;
         Mono with SemiBold for inline code), and the VARIABLE Source Serif 4
         and Source Code Pro (07.09.2026: every weight from one file) — see
         resources/fonts/README.md. -->
    <qresource prefix="/fonts">
        <file alias="IBMPlexMono-Regular.ttf">fonts/IBMPlexMono-Regular.ttf</file>
        <file alias="IBMPlexMono-Italic.ttf">fonts/IBMPlexMono-Italic.ttf</file>
        <file alias="IBMPlexMono-SemiBold.ttf">fonts/IBMPlexMono-SemiBold.ttf</file>
        <file alias="IBMPlexMono-SemiBoldItalic.ttf">fonts/IBMPlexMono-SemiBoldItalic.ttf</file>
        <file alias="IBMPlexMono-Bold.ttf">fonts/IBMPlexMono-Bold.ttf</file>
        <file alias="IBMPlexMono-BoldItalic.ttf">fonts/IBMPlexMono-BoldItalic.ttf</file>
        <file alias="IBMPlexSans-Regular.ttf">fonts/IBMPlexSans-Regular.ttf</file>
        <file alias="IBMPlexSans-Italic.ttf">fonts/IBMPlexSans-Italic.ttf</file>
        <file alias="IBMPlexSans-SemiBold.ttf">fonts/IBMPlexSans-SemiBold.ttf</file>
        <file alias="IBMPlexSans-SemiBoldItalic.ttf">fonts/IBMPlexSans-SemiBoldItalic.ttf</file>
        <file alias="IBMPlexSans-Bold.ttf">fonts/IBMPlexSans-Bold.ttf</file>
        <file alias="IBMPlexSans-BoldItalic.ttf">fonts/IBMPlexSans-BoldItalic.ttf</file>
        <file alias="IBMPlexSans_SemiCondensed-Regular.ttf">fonts/IBMPlexSans_SemiCondensed-Regular.ttf</file>
        <file alias="IBMPlexSans_SemiCondensed-Italic.ttf">fonts/IBMPlexSans_SemiCondensed-Italic.ttf</file>
        <file alias="IBMPlexSans_SemiCondensed-Bold.ttf">fonts/IBMPlexSans_SemiCondensed-Bold.ttf</file>
        <file alias="IBMPlexSans_SemiCondensed-BoldItalic.ttf">fonts/IBMPlexSans_SemiCondensed-BoldItalic.ttf</file>
        <file alias="SourceSerif4-Variable.ttf">fonts/SourceSerif4-Variable.ttf</file>
        <file alias="SourceSerif4-VariableItalic.ttf">fonts/SourceSerif4-VariableItalic.ttf</file>
        <file alias="SourceCodePro-Variable.ttf">fonts/SourceCodePro-Variable.ttf</file>
        <file alias="SourceCodePro-VariableItalic.ttf">fonts/SourceCodePro-VariableItalic.ttf</file>
    </qresource>

    <!-- Шрифты формул: математический Euler Math 0.75 (выбор владельца —
         прямые буквы Цапфа и Кнута, компактнее конкурентов, что важно для
         инлайна) и текстовый компаньон Latin Modern, которым набирается
         \text{…} внутри математики. Рядом с каждым .otf лежит .clm2 —
         метрики и контуры глифов в формате MicroTeX; чем он сделан, написано
         в resources/fonts/math/README.md.

         Qt-бэкенд движка читает шрифт прямо из ресурсов: не найдя файла на
         диске, он приписывает к имени ":/" (upstream/platform/qt/graphic_qt.cpp,
         Font_qt::loadFont). Поэтому распаковывать во временный каталог ничего
         не нужно — бинарник остаётся самодостаточным. -->
    <qresource prefix="/fonts/math">
        <file alias="EulerMath.otf">fonts/math/EulerMath.otf</file>
        <file alias="EulerMath.clm2">fonts/math/EulerMath.clm2</file>
        <file alias="lmroman10-regular.otf">fonts/math/lmroman10-regular.otf</file>
        <file alias="lmroman10-regular.clm2">fonts/math/lmroman10-regular.clm2</file>
        <file alias="lmroman10-italic.otf">fonts/math/lmroman10-italic.otf</file>
        <file alias="lmroman10-italic.clm2">fonts/math/lmroman10-italic.clm2</file>
        <file alias="lmroman10-bold.otf">fonts/math/lmroman10-bold.otf</file>
        <file alias="lmroman10-bold.clm2">fonts/math/lmroman10-bold.clm2</file>
        <file alias="lmroman10-bolditalic.otf">fonts/math/lmroman10-bolditalic.otf</file>
        <file alias="lmroman10-bolditalic.clm2">fonts/math/lmroman10-bolditalic.clm2</file>
    </qresource>
</RCC>
