<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app's files leaves the device: neither into the cloud
     backup nor through a device-to-device transfer (brief android0, §6). The
     store is private data; it travels only through the sync, encrypted. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
