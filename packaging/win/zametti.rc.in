/* Ресурсы Windows. Путь подставляет CMake при настройке: windres ищет файлы
   относительно СВОЕГО текущего каталога, а он у сборки не тот, где лежит .rc, —
   относительное имя здесь молча не находилось бы. */
#include <windows.h>

/* ЗНАЧОК САМОГО .exe. setWindowIcon() красит заголовок окна и панель задач на
   исполнении, а проводник, рабочий стол и диалог «Открыть с помощью» берут
   значок совсем не оттуда — из ресурса RT_GROUP_ICON внутри файла. Без него
   программа безлика ровно там, где человек её впервые и видит.

   Имя ресурса — самое первое по порядку сортировки, и это не украшение:
   проводник показывает НАИМЕНЬШИЙ по имени значок группы, а не первый по
   тексту .rc. «AAA» гарантирует, что при появлении вторых значков (документа,
   например) программа не поменяет лицо молча. */
AAA_ZAMETTI_ICON ICON "@ZAMETTI_WIN_ICO@"

/* Манифест — см. рядом zametti.manifest, причина написана там. */
1 RT_MANIFEST "@ZAMETTI_WIN_MANIFEST@"

/* ВЕРСИЯ .exe — та же, что объявлена один раз в project(... VERSION) корневого
   CMakeLists.txt: её показывает проводник в свойствах файла. Четвёртое число
   у Windows обязательное, у нас его нет — ноль. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vadim Pisarevsky"
            VALUE "FileDescription",  "Zametti - markdown notes"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "zametti"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Vadim Pisarevsky. GPL-3.0"
            VALUE "OriginalFilename", "zametti.exe"
            VALUE "ProductName",      "Zametti"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
