/* Windows resources. The paths are substituted by CMake at configure time:
   windres looks for files relative to ITS OWN current directory, which in the
   build is not the one holding the .rc, so a relative name here would silently
   fail to be found. */
#include <windows.h>

/* THE ICON OF THE .exe ITSELF. setWindowIcon() paints the window title and the
   taskbar at run time, but Explorer, the desktop and the "Open with" dialog
   take the icon from somewhere else entirely: the RT_GROUP_ICON resource inside
   the file. Without it the program is faceless exactly where a person first
   sees it.

   The resource name is the very first in sort order, and that is not
   decoration: Explorer shows the icon group with the SMALLEST name, not the
   first one in .rc text order. "AAA" guarantees that when further icons appear
   (a document icon, for example) the program will not change its face
   silently. */
AAA_ZAMETTI_ICON ICON "@ZAMETTI_WIN_ICO@"

/* Manifest: see zametti.manifest next to this file; the reason is written there. */
1 RT_MANIFEST "@ZAMETTI_WIN_MANIFEST@"

/* VERSION of the .exe: the same one declared once in project(... VERSION) of
   the root CMakeLists.txt; Explorer shows it in the file properties. Windows
   requires a fourth number and we have none, so it is zero. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vadim Pisarevsky"
            VALUE "FileDescription",  "Zametti - markdown notes"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "zametti"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Vadim Pisarevsky. GPL-3.0"
            VALUE "OriginalFilename", "zametti.exe"
            VALUE "ProductName",      "Zametti"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
