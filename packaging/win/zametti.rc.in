/* Ресурс Windows: единственное его содержимое — манифест (см. рядом
   zametti.manifest, там же и причина). Путь подставляет CMake при настройке:
   windres ищет файл относительно СВОЕГО текущего каталога, а он у сборки не тот,
   где лежит .rc, — относительное имя здесь молча не находилось бы. */
#include <windows.h>
1 RT_MANIFEST "@ZAMETTI_WIN_MANIFEST@"
