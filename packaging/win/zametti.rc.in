/* Ресурсы Windows. Путь подставляет CMake при настройке: windres ищет файлы
   относительно СВОЕГО текущего каталога, а он у сборки не тот, где лежит .rc, —
   относительное имя здесь молча не находилось бы. */
#include <windows.h>

/* ЗНАЧОК САМОГО .exe. setWindowIcon() красит заголовок окна и панель задач на
   исполнении, а проводник, рабочий стол и диалог «Открыть с помощью» берут
   значок совсем не оттуда — из ресурса RT_GROUP_ICON внутри файла. Без него
   программа безлика ровно там, где человек её впервые и видит.

   Имя ресурса — самое первое по порядку сортировки, и это не украшение:
   проводник показывает НАИМЕНЬШИЙ по имени значок группы, а не первый по
   тексту .rc. «AAA» гарантирует, что при появлении вторых значков (документа,
   например) программа не поменяет лицо молча. */
AAA_ZAMETTI_ICON ICON "@ZAMETTI_WIN_ICO@"

/* Манифест — см. рядом zametti.manifest, причина написана там. */
1 RT_MANIFEST "@ZAMETTI_WIN_MANIFEST@"
