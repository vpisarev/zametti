<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ПОРОЖДАЕТСЯ CMake из packaging/mac/Info.plist.in — править надо шаблон.
     Версия — та же, что объявлена один раз в project(... VERSION) корневого
     CMakeLists.txt; второго места с числом версии в проекте нет. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>      <string>io.zametti.zametti</string>
    <key>CFBundleName</key>            <string>Zametti</string>
    <key>CFBundleExecutable</key>      <string>zametti</string>
    <key>CFBundleIconFile</key>        <string>zametti</string>
    <key>CFBundlePackageType</key>     <string>APPL</string>
    <key>CFBundleShortVersionString</key> <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>         <string>@PROJECT_VERSION@</string>
    <key>LSMinimumSystemVersion</key>  <string>@ZAMETTI_MACOS_MIN@</string>
    <key>NSHighResolutionCapable</key> <true/>
</dict>
</plist>
