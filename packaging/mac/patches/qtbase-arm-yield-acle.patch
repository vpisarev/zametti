@@ -20,6 +20,23 @@ extern "C"
 void _mm_pause(void);       // the compiler recognizes as intrinsic
 #endif
 
+// ZAMETTI PATCH (mac, arm64, AppleClang 21 / Xcode 26).
+//
+// Below sits `#if __has_builtin(__yield)` and a call to __yield() without a
+// declaration. Earlier clangs provided it as a builtin silently; AppleClang 21
+// treats __yield as a LIBRARY function — __has_builtin is still true, but no
+// declaration is in scope, and -Werror,-Wimplicit-function-declaration fires.
+// The Qt build dies on file 186 of 1865, still in bootstrap.
+//
+// The declaration lives in <arm_acle.h> (ARM C Language Extensions) — the
+// compiler itself hints at this in a note. We include it where it exists and
+// nothing more: silencing the warning would leave the call undeclared.
+#if defined(Q_PROCESSOR_ARM) && defined(__has_include)
+#  if __has_include(<arm_acle.h>)
+#    include <arm_acle.h>
+#  endif
+#endif
+
 QT_BEGIN_NAMESPACE
 
 Q_ALWAYS_INLINE
