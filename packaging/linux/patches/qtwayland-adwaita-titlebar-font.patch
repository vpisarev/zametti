+void QWaylandAdwaitaDecoration::zamettiUpdateTitlebarFont()
+{
+    // При titlebar-uses-system-font заголовок рисуется шрифтом интерфейса,
+    // иначе — тем, что назван в titlebar-font.
+    const QString description = (m_zamettiUsesSystemFont && !m_zamettiSystemFont.isEmpty())
+            ? m_zamettiSystemFont
+            : m_zamettiTitlebarFont;
+
+    if (!zametti_applyFontDescription(m_font.get(), description))
+        return;
+
+    // Заголовки GNOME полужирные даже когда шрифт взят из интерфейса: жирность
+    // объявлена отдельно, в titlebar-font.
+    if (m_zamettiTitlebarFont.contains("bold"_L1, Qt::CaseInsensitive))
+        m_font->setBold(true);
+
+    // Раскладку статического текста готовим ТЕМ ЖЕ шрифтом, которым будем
+    // рисовать. У upstream prepare() зовётся без аргументов, то есть шрифтом
+    // приложения, и размер, по которому текст центрируется в заголовке,
+    // берётся от чужих метрик.
+    m_windowTitle.prepare(QTransform(), *m_font);
+
+    // Печатаем и то, что ПРОСИЛИ, и то, что получилось: если названного
+    // семейства в системе нет, fontconfig молча подставит другое, и заголовок
+    // окажется другого размера при том же числе пунктов.
+    {
+        const QFontInfo resolved(*m_font);
+        const QScreen *screen = QGuiApplication::primaryScreen();
+        qCDebug(lcQWaylandAdwaitaDecorationLog)
+            << "Titlebar font:" << description << "-> resolved" << resolved.family()
+            << resolved.pointSizeF() << "pt," << resolved.pixelSize() << "px, height"
+            << QFontMetricsF(*m_font).height()
+            << "| screen dpi" << (screen ? screen->logicalDotsPerInch() : -1.0)
+            << "dpr" << (screen ? screen->devicePixelRatio() : -1.0);
+    }
+    requestRepaint();
+}
