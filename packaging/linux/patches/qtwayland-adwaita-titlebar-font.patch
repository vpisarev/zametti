     } else if (group == "org.freedesktop.appearance"_L1 && key == "color-scheme"_L1) {
         const uint colorScheme = value.variant().toUInt();
         updateColors(colorScheme == 1); // 1 == Prefer Dark
+    } else if (group == "org.gnome.desktop.wm.preferences"_L1 && key == "titlebar-font"_L1) {
+        m_zamettiTitlebarFont = value.variant().toString();
+        zamettiUpdateTitlebarFont();
+    } else if (group == "org.gnome.desktop.wm.preferences"_L1
+               && key == "titlebar-uses-system-font"_L1) {
+        m_zamettiUsesSystemFont = value.variant().toBool();
+        zamettiUpdateTitlebarFont();
+    } else if (group == "org.gnome.desktop.interface"_L1 && key == "font-name"_L1) {
+        m_zamettiSystemFont = value.variant().toString();
+        zamettiUpdateTitlebarFont();
     }
 }
 
