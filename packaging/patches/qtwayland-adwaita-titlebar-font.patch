+// zametti: разбор описания шрифта в стиле Pango, каким его отдаёт GNOME:
+// "Семейство [Начертание] Размер", например "Adwaita Sans Bold 11" или
+// "Cantarell 11". Возвращает false, не тронув шрифт, если строку не понял.
+static bool zametti_applyFontDescription(QFont *font, const QString &description)
+{
+    if (!font || description.isEmpty())
+        return false;
+
+    QStringList tokens = description.split(u' ', Qt::SkipEmptyParts);
+    if (tokens.size() < 2)
+        return false;
+
+    bool sizeOk = false;
+    const qreal pointSize = tokens.constLast().toDouble(&sizeOk);
+    if (!sizeOk || pointSize <= 0)
+        return false;
+    tokens.removeLast();
+
+    static const char *const styleWords[] = {
+        "thin", "ultra-light", "extra-light", "light", "semi-light", "book",
+        "regular", "normal", "medium", "semi-bold", "demi-bold", "bold",
+        "ultra-bold", "extra-bold", "heavy", "black", "italic", "oblique",
+        "ultra-condensed", "extra-condensed", "condensed", "semi-condensed",
+        "semi-expanded", "expanded", "extra-expanded", "ultra-expanded"
+    };
+
+    bool bold = false;
+    bool italic = false;
+    while (tokens.size() > 1) {
+        const QString word = tokens.constLast().toLower();
+        bool known = false;
+        for (const char *const style : styleWords) {
+            if (word == QLatin1StringView(style)) {
+                known = true;
+                break;
+            }
+        }
+        if (!known)
+            break;
+        if (word == "bold"_L1 || word == "ultra-bold"_L1 || word == "extra-bold"_L1
+            || word == "heavy"_L1 || word == "black"_L1) {
+            bold = true;
+        } else if (word == "italic"_L1 || word == "oblique"_L1) {
+            italic = true;
+        }
+        tokens.removeLast();
+    }
+
+    font->setFamily(tokens.join(u' '));
+    font->setPointSizeF(pointSize);
+    font->setBold(bold);
+    font->setItalic(italic);
+    return true;
+}
