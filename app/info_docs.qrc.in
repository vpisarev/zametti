<!-- ПОРОЖДАЕТСЯ CMake из info_docs.qrc.in — править надо шаблон, а не результат
     в каталоге сборки.

     Здесь список всего, что лежит в docs/info/: markdown документации и
     картинки к ней. Списка нет ни в этом файле, ни в коде — его собирает
     app/CMakeLists.txt обходом каталога (file GLOB с CONFIGURE_DEPENDS).
     Так расширение документации становится тем, чем и должно быть: положил
     файл в docs/info/ — он в программе и в папке Info дерева заметок.

     Псевдонимы — ИМЕНА ФАЙЛОВ БЕЗ ПУТИ, и это важно: ссылка на картинку
     внутри документа (`![](pic.jxl)`) разрешается видом относительно каталога
     самого документа, то есть в ":/docs/info/pic.jxl". Разложи мы файлы
     подкаталогами — ссылки бы поехали. -->
<RCC>
    <qresource prefix="/docs/info">
@ZAMETTI_INFO_ENTRIES@    </qresource>
</RCC>
