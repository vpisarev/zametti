<!-- Иконка вшивается в бинарник: путь до art/ на машине пользователя неизвестен.
     zametti.png — 512×512, палитра 256 цветов: 121 КБ против 304 КБ у
     zametti_lossless.png рядом, при PSNR 45.3 дБ и SSIM 0.9987 (разницы не
     видно и на увеличении втрое). Правится lossless-вариант, c256 — из него. -->
<RCC>
    <qresource prefix="/">
        <file alias="zametti.png">../art/zametti.png</file>
    </qresource>
</RCC>
