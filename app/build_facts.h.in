// ПОРОЖДАЕТСЯ CMake из build_facts.h.in — править надо шаблон, а не результат.
//
// Здесь ровно те же числа, которые CMake печатает в сводке при настройке
// (zametti_summary в корневом CMakeLists.txt). Второго списка версий в
// программе нет намеренно: он разошёлся бы с настоящим первым же обновлением
// вендоринга, и окно «О программе» врало бы с уверенным видом.
//
// Отметка коммита снимается в момент НАСТРОЙКИ, а не сборки: иначе каждая
// пересборка трогала бы этот заголовок и тянула за собой весь app. Поэтому
// рядом с ней так и написано — «настроено».

#ifndef ZAMETTI_BUILD_FACTS_H
#define ZAMETTI_BUILD_FACTS_H

namespace zametti {

// ВЕРСИЯ ПРОГРАММЫ — из project(... VERSION) корневого CMakeLists.txt, и
// только оттуда: окно «О программе», --version и заголовки берут её здесь.
constexpr const char* kVersion = "@PROJECT_VERSION@";

struct BuildFact {
    const char* name;
    const char* value;
};

// Одна строка на вшитую библиотеку: имя, версия, зачем она нам.
struct VendoredFact {
    const char* name;
    const char* version;
    const char* what;
};

constexpr BuildFact kBuildFacts[] = {
    {"platform", "@ZAMETTI_FACT_PLATFORM@"},
    {"build", "@ZAMETTI_FACT_CONFIG@"},
    {"compiler", "@ZAMETTI_FACT_COMPILER@"},
    {"Qt", "@ZAMETTI_FACT_QT@"},
    {"commit", "@ZAMETTI_FACT_COMMIT@"},
    {"configured", "@ZAMETTI_FACT_CONFIGURED@"},
};

constexpr VendoredFact kVendoredFacts[] = {
    {"blake3", "@BLAKE3_VENDORED_VERSION@", "hashes of notes and attachments"},
    {"dtl", "@DTL_VENDORED_VERSION@", "version diffs in history"},
    {"highway", "@HWY_VENDORED_VERSION@", "SIMD library for libjxl and jpegli"},
    {"jpegli", "@JPEGLI_VENDORED_COMMIT@", "high-fidelity jpeg decoder"},
    {"libde265", "@DE265_VENDORED_VERSION@", "hevc decoder inside heic"},
    {"libgav1", "@LIBGAV1_VENDORED_VERSION@", "av1 decoder inside avif"},
    {"libheif", "@HEIF_VENDORED_VERSION@", "heif and avif container"},
    {"libjxl", "@JXL_VENDORED_VERSION@", "jpegxl codec, jxl <=> jpeg transcoder, SSIMULACRA2"},
    {"libsodium", "@SODIUM_VENDORED_VERSION@", "XChaCha20-Poly1305 and Argon2id for the cloud sync"},
    {"libtiff", "@TIFF_VENDORED_VERSION@", "tiff decoder with Lab/CMYK, ICC, XMP and EXIF support"},
    {"libwebp", "@LIBWEBP_VENDORED_VERSION@", "webp decoder"},
    {"md4c", "@MD4C_VENDORED_VERSION@", "markdown parsing"},
    {"microtex", "@MICROTEX_VENDORED_VERSION@", "microtex Latex formula rendering engine"},
    {"zlib", "@ZLIB_VENDORED_VERSION@", "deflate inside tiff's"},
    {"zstd", "@ZSTD_VENDORED_VERSION@", "compress journals"},
};

// Читатели картинок сверх тех, что умеет сама Qt. Строка постоянная с тех
// пор, как avif и heic читаются вшитым кодом, но берётся всё равно из
// сводки настройки — второго списка форматов в программе нет.
constexpr const char* kImageReaders = "@ZAMETTI_FACT_READERS@";

}  // namespace zametti

#endif  // ZAMETTI_BUILD_FACTS_H
